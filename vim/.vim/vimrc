" binding config {{{
""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""
" Use jk to escape insert mode
inoremap jk <esc>

" Use some key mappings to compile and run quickly
" In these files, when I press <tab>, it complies and runs automatically,
" I don't know which plugin works. But it's convenient. It works like <C-i>
autocmd FileType cpp nnoremap R :w<CR>:!g++ -std=c++20 % -o %<<CR>:!./%<<CR>
autocmd FileType c nnoremap R :w<CR>:!gcc % -o %<<CR>:!./%<<CR>
autocmd FileType python nnoremap R :w<CR>:!python3 %<CR>
" It doesn't work
" autocmd FileType markdown nnoremap R :InstantMarkdownPreview<CR>

" Have j and k navigate visual lines in normal mode
nnoremap <silent> <Plug>RealJ j
nnoremap <expr> j (v:count > 0) ? '<Plug>RealJ' : 'gj'
nnoremap <silent> <Plug>RealK k
nnoremap <expr> k (v:count > 0) ? '<Plug>RealK' : 'gk'

nnoremap S :w<CR>
nnoremap Q :q<CR>

" Use C-w, C-l to delete a word/letter in insert mode and cmd-line mode
inoremap <C-w> <esc>lcb
inoremap <C-h> <Backspace>
inoremap <C-a> <Home>
inoremap <C-e> <End>
inoremap <C-f> <Right>
inoremap <C-b> <Left>

" find next placeholder(<++>) and edit it
nnoremap <leader><leader> /<++><CR>c4l

" change window size
nnoremap <C-h> <C-w><
nnoremap <C-j> <C-w>-
nnoremap <C-k> <C-w>+
nnoremap <C-l> <C-w>>

" shift between windows
nnoremap <S-h> <C-w>h
nnoremap <S-j> <C-w>j
nnoremap <S-k> <C-w>k
nnoremap <S-l> <C-w>l

" shift between buffers
" 'bn', 'bp' will make b very slow
" 'nb', 'pb' will make n, p very slow
nnoremap <leader>n :bn<CR>
nnoremap <leader>p :bp<CR>
nnoremap <leader>x :bd<CR>

" " edit .vimrc when editing other files
" autocmd FileType python nnoremap <C-i> :!python3 %<CR>
" nnoremap <leader>vim :e $MYVIMRC<CR>
" nnoremap <leader>rc :vsp $MYVIMRC<CR>
" " source my .vimrc
autocmd FileType vim nnoremap <leader>sv :w <CR> :source $MYVIMRC<CR>
" " install and clean plugins
autocmd FileType vim nnoremap <leader>in :PlugInstall<CR>
autocmd FileType vim nnoremap <leader>cl :PlugClean<CR>
" }}}


